// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.

// Must be unique to you, e.g. com.yourname.macrorouter
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.macrorouter

// Your Team ID: Xcode > Settings > Accounts > (your Apple ID) > Personal Team.
// It is also shown in the Signing & Capabilities tab after you pick your team once.
DEVELOPMENT_TEAM = ABCDE12345

// Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY works but is heavily rate-limited).
USDA_API_KEY = DEMO_KEY
